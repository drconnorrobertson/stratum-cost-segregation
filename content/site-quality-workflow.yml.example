name: Website quality
on:
  pull_request:
  push:
    branches: [main]
permissions:
  contents: read
jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - name: Rebuild and verify committed output
        run: |
          python3 build_str_seo.py
          git diff --exit-code -- '*.html' sitemap.xml assets/
      - name: Validate content and navigation
        run: python3 validate_str_seo.py
      - name: Validate scripts and public package
        run: |
          node --check assets/blog-search.js
          node --check assets/market-search.js
          node --check assets/str-study-planner.js
          node build_static.mjs
          test ! -e public/content
          test ! -e public/build_str_seo.py
          test -e public/robots.txt
          test -e public/404.html
