{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build_static.mjs",
  "outputDirectory": "public",
  "trailingSlash": true,
  "redirects": [
    {"source": "/index.html", "destination": "/", "permanent": true},
    {"source": "/:path*/index.html", "destination": "/:path*/", "permanent": true}
  ]
}
